<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yun.naverblog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>cd /Users/yun/scripts &amp;&amp; /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 naver_blog_collector.py --backfill</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yun/scripts</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/yun/logs/naver_blog_collector.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/yun/logs/naver_blog_collector.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
